# Supabase Configuration Example
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# URL công khai dùng cho metadataBase, canonical, sitemap và robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Bật dữ liệu booking demo chỉ trong môi trường local khi cần kiểm thử offline.
NEXT_PUBLIC_USE_DEMO_BOOKINGS=false
# Server-only. Chỉ cần cho script migration/admin server; tuyệt đối không dùng NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
